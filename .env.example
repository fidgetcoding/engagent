# Leave ENGAGENT_DEMO=1 to click around with sample data. No keys, no paid calls.
ENGAGENT_DEMO=1

# Real use: set ENGAGENT_DEMO=0 and fill these in.
ENGAGENT_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Comma-separated. Message your bot /whoami to get yours.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: scans use sample finds without it.
APIFY_TOKEN=
# Optional: plain-English Telegram messages need it. Slash commands work without it.
ANTHROPIC_API_KEY=
